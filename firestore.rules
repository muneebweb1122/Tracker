rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Profile: name, uid6, sharing flag
    match /users/{u} {
      allow read: if request.auth != null;
      allow create, update: if request.auth.uid == u;
    }

    // Track requests: doc id = fromUid_toUid
    match /requests/{id} {
      allow create: if request.auth.uid == request.resource.data.from
                    && request.resource.data.status == 'pending';
      allow read: if request.auth.uid in [resource.data.from, resource.data.to];
      allow update: if request.auth.uid == resource.data.to;
      allow delete: if request.auth.uid in [resource.data.from, resource.data.to];
    }

    // Live location: only owner, or someone whose request was ACCEPTED
    match /locations/{u} {
      allow write: if request.auth.uid == u;
      allow read: if request.auth.uid == u
        || (exists(/databases/$(database)/documents/requests/$(request.auth.uid + '_' + u))
            && get(/databases/$(database)/documents/requests/$(request.auth.uid + '_' + u)).data.status == 'accepted');
    }
  }
}
